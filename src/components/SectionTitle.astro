---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, badge, align = 'center' } = Astro.props;
const isCenter = align === 'center';
---

<div class={`space-y-2.5 mb-10 ${isCenter ? 'text-center max-w-3xl mx-auto' : 'text-left'}`}>
  {badge && (
    <span class="inline-block px-3 py-1 rounded-md text-[11px] font-semibold text-brand-glow bg-brand-600/15 border border-brand-500/25 tracking-wider uppercase">
      {badge}
    </span>
  )}
  <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
    {title}
  </h2>
  {subtitle && (
    <p class="text-sm sm:text-base text-gray-400 leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
