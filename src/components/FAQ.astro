---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
}

const { items, title = '常见问题解答 (FAQ)' } = Astro.props;
---

<div class="my-8 space-y-4">
  {title && <h3 class="text-xl font-bold text-white mb-4">{title}</h3>}
  <div class="space-y-3">
    {items.map((item, index) => (
      <details class="group rounded-xl bg-dark-card border border-dark-border p-4 [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex cursor-pointer items-center justify-between font-semibold text-sm sm:text-base text-white group-hover:text-brand-glow transition-colors">
          <span class="flex items-center gap-2">
            <span class="text-brand-glow font-mono font-bold text-xs bg-brand-600/20 px-2 py-0.5 rounded">Q{index + 1}</span>
            {item.q}
          </span>
          <span class="ml-1.5 shrink-0 rounded-full bg-gray-800 p-1 text-gray-400 group-open:-rotate-180 transition-transform">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 text-xs sm:text-sm text-gray-400 leading-relaxed pl-8 border-t border-dark-border/40 pt-3">
          {item.a}
        </p>
      </details>
    ))}
  </div>
</div>
