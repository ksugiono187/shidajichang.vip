---
import { homepageData } from '../data/homepage';

const { hero } = homepageData;
---

<section class="relative pt-12 pb-16 lg:pt-20 lg:pb-24 overflow-hidden bg-gradient-glow border-b border-dark-border/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-600/15 border border-brand-500/30 text-brand-glow text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          {hero.badge}
        </div>

        <!-- Main Title -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-gray-100 to-indigo-200">
            {hero.title}
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-gray-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          {hero.subtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href={hero.primaryCta.href}
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-sm text-white bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 shadow-glow-md hover:shadow-glow-lg transition-all text-center"
          >
            {hero.primaryCta.text} →
          </a>
          <a
            href={hero.secondaryCta.href}
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold text-sm text-gray-200 bg-dark-card border border-dark-border hover:border-gray-600 hover:bg-dark-hover transition-all text-center"
          >
            {hero.secondaryCta.text}
          </a>
        </div>
      </div>

      <!-- Right Column: Premium Information Card -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl bg-card-gradient border border-glow p-6 lg:p-8 backdrop-blur-xl shadow-2xl">
          <div class="flex items-center justify-between border-b border-dark-border/80 pb-4 mb-5">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-glow bg-brand-600/20 px-2.5 py-1 rounded-md">
              {hero.highlightCard.tag}
            </span>
            <span class="text-xs text-gray-400 font-mono">100% 客观中立</span>
          </div>

          <h2 class="text-xl font-bold text-white mb-2">
            {hero.highlightCard.title}
          </h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6">
            {hero.highlightCard.desc}
          </p>

          <!-- Metrics strip -->
          <div class="grid grid-cols-3 gap-3 pt-2 border-t border-dark-border/60">
            {hero.highlightCard.metrics.map((m) => (
              <div class="text-center p-2 rounded-lg bg-dark-bg/60 border border-dark-border/40">
                <div class="text-lg font-black text-white">{m.value}</div>
                <div class="text-[11px] text-gray-400">{m.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
