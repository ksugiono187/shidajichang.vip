---
interface Props {
  title: string;
  description: string;
  slug: string;
  count?: number;
}

const { title, description, slug, count = 5 } = Astro.props;
---

<div class="group relative p-6 rounded-2xl bg-card-gradient border border-dark-border hover:border-brand-500/50 hover:bg-dark-hover transition-all duration-300">
  <div class="flex items-center justify-between mb-3">
    <span class="text-[10px] font-bold text-brand-glow bg-brand-600/20 border border-brand-500/30 px-2.5 py-0.5 rounded-md uppercase tracking-wider">
      SEO 专题
    </span>
    <span class="text-[11px] text-gray-400 font-mono">
      包含 {count} 篇核心指南
    </span>
  </div>

  <h3 class="text-lg font-bold text-white group-hover:text-brand-glow transition-colors mb-2">
    <a href={`/topics/${slug}`}>
      <span class="absolute inset-0"></span>
      {title}
    </a>
  </h3>

  <p class="text-xs text-gray-400 line-clamp-3 leading-relaxed mb-4">
    {description}
  </p>

  <div class="flex items-center text-xs font-semibold text-brand-glow">
    探索完整专题架构
    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7-7 7" />
    </svg>
  </div>
</div>
