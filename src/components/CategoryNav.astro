---
import { categoriesMeta } from '../data/categories';

interface Props {
  currentSlug?: string;
}

const { currentSlug = '' } = Astro.props;
const categoryList = Object.values(categoriesMeta);
---

<div class="flex items-center gap-2 overflow-x-auto py-2 mb-8 scrollbar-none">
  <a
    href="/blog"
    class={`px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${
      !currentSlug
        ? 'bg-brand-600 text-white shadow-glow-sm'
        : 'bg-dark-card text-gray-300 hover:bg-gray-800 hover:text-white border border-dark-border'
    }`}
  >
    全部文章
  </a>

  {categoryList.map((cat) => {
    const isActive = currentSlug === cat.slug;
    return (
      <a
        href={`/category/${cat.slug}`}
        class={`px-4 py-2 rounded-xl text-xs font-semibold whitespace-nowrap transition-all ${
          isActive
            ? 'bg-brand-600 text-white shadow-glow-sm'
            : 'bg-dark-card text-gray-300 hover:bg-gray-800 hover:text-white border border-dark-border'
        }`}
      >
        {cat.name}
      </a>
    );
  })}
</div>
