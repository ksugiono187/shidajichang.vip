---
import { getCategoryMeta } from '../data/categories';

interface Props {
  title: string;
  description: string;
  slug: string;
  pubDate: Date | string;
  category: string;
  tags?: string[];
  author?: string;
}

const { title, description, slug, pubDate, category, tags = [], author = 'SEO 内容团队' } = Astro.props;

const categoryInfo = getCategoryMeta(category);
const formattedDate = new Date(pubDate).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="group relative flex flex-col justify-between p-6 rounded-2xl bg-dark-card border border-dark-border hover:border-brand-500/40 hover:bg-dark-hover transition-all duration-300">
  <div>
    <!-- Header meta -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <a
        href={`/category/${categoryInfo.slug}`}
        class="inline-block text-[11px] font-semibold text-brand-glow bg-brand-600/15 border border-brand-500/20 px-2.5 py-0.5 rounded-full hover:bg-brand-600/30 transition-colors"
      >
        {categoryInfo.name}
      </a>
      <time class="text-[11px] text-gray-500 font-mono">{formattedDate}</time>
    </div>

    <!-- Title -->
    <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-brand-glow transition-colors line-clamp-2 mb-2">
      <a href={`/blog/${slug}`}>
        <span class="absolute inset-0"></span>
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-xs text-gray-400 line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>
  </div>

  <!-- Footer meta & tags -->
  <div class="pt-4 border-t border-dark-border/50 flex items-center justify-between text-[11px] text-gray-500">
    <span class="font-medium text-gray-400">{author}</span>

    {tags.length > 0 && (
      <div class="flex items-center gap-1.5 overflow-hidden">
        {tags.slice(0, 2).map((t) => (
          <span class="text-[10px] text-gray-400 bg-gray-800/60 px-2 py-0.5 rounded">
            #{t}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
