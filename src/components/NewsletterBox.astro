---
interface Props {
  title?: string;
  desc?: string;
}

const {
  title = '获取最新评测报告与技术快报',
  desc = '订阅我们的最新更新，获取第一手晚高峰压测数据与独家专题指南。（占位展示）',
} = Astro.props;
---

<div class="my-10 p-6 rounded-2xl bg-dark-card border border-dark-border">
  <div class="max-w-xl space-y-3">
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 rounded-full bg-brand-glow animate-pulse"></div>
      <h4 class="text-base font-bold text-white">{title}</h4>
    </div>
    <p class="text-xs text-gray-400">{desc}</p>
    <form class="flex flex-col sm:flex-row gap-2 pt-1" onsubmit="return false;">
      <input
        type="email"
        placeholder="输入您的电子邮箱地址..."
        class="flex-1 px-4 py-2.5 rounded-xl bg-dark-bg border border-dark-border text-xs text-white placeholder-gray-500 focus:outline-none focus:border-brand-500"
      />
      <button
        type="submit"
        class="px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-brand-600 hover:bg-brand-500 transition-colors"
      >
        免费订阅
      </button>
    </form>
  </div>
</div>
