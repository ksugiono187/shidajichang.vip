---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTASection from '../components/CTASection.astro';
import FAQ from '../components/FAQ.astro';
import PostNavButtons from '../components/PostNavButtons.astro';
import { getCategoryMeta } from '../data/categories';
import { siteConfig } from '../data/site';

interface PostInfo {
  title: string;
  slug: string;
}

interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  author?: string;
  faqs?: FAQItem[];
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: PostInfo | null;
  nextPost?: PostInfo | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags = [],
  author = '十大机场评测编辑部',
  faqs,
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const categoryInfo = getCategoryMeta(category);
const formattedPubDate = new Date(pubDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdatedDate = updatedDate ? new Date(updatedDate).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

const breadcrumbItems = [
  { title: '博客指南', href: '/blog' },
  { title: categoryInfo.name, href: `/category/${categoryInfo.slug}` },
  { title: title },
];

const articleImageUrl = new URL('/og-image.jpg', siteConfig.domain).href;

// JSON-LD 结构化数据 (Article / BlogPosting, BreadcrumbList)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'image': [articleImageUrl],
  'datePublished': new Date(pubDate).toISOString(),
  'dateModified': new Date(updatedDate || pubDate).toISOString(),
  'articleSection': categoryInfo.name,
  'keywords': tags.length > 0 ? tags.join(', ') : categoryInfo.name,
  'inLanguage': 'zh-CN',
  'isAccessibleForFree': 'true',
  'author': {
    '@type': 'Organization',
    'name': author,
    'url': siteConfig.domain,
  },
  'publisher': {
    '@type': 'Organization',
    'name': siteConfig.name,
    'logo': {
      '@type': 'ImageObject',
      'url': `${siteConfig.domain}/favicon.svg`,
    },
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, siteConfig.domain).href,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    'position': index + 1,
    'name': item.title,
    'item': item.href ? new URL(item.href, siteConfig.domain).href : undefined,
  })),
};

const jsonLd: any[] = [articleSchema, breadcrumbSchema];

if (faqs && faqs.length > 0) {
  const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    'mainEntity': faqs.map((faq) => ({
      '@type': 'Question',
      'name': faq.q,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': faq.a,
      },
    })),
  };
  jsonLd.push(faqSchema);
}
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbItems} />

    <!-- Top Post Navigation Buttons -->
    <PostNavButtons prevPost={prevPost} nextPost={nextPost} position="top" />

    <!-- Article Header -->
    <header class="my-6 space-y-4 border-b border-dark-border/80 pb-8">
      <div class="flex items-center gap-3">
        <a
          href={`/category/${categoryInfo.slug}`}
          class="text-xs font-semibold text-brand-glow bg-brand-600/20 border border-brand-500/30 px-3 py-1 rounded-full"
        >
          {categoryInfo.name}
        </a>
        {tags.map((tag) => (
          <a href={`/tag/${tag}`} class="text-xs text-gray-400 hover:text-white bg-gray-800/80 px-2.5 py-1 rounded-md">
            #{tag}
          </a>
        ))}
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
        {title}
      </h1>

      <p class="text-sm sm:text-base text-gray-300 leading-relaxed font-normal">
        {description}
      </p>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-gray-300 font-mono pt-3 border-t border-dark-border/60">
        <div class="flex items-center gap-1.5">
          <span class="text-gray-400">撰写团队:</span>
          <a href="/about" class="text-brand-glow font-bold hover:underline inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-brand-glow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            {author}
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-gray-400">测试方法:</span>
          <a href="/methodology" class="text-indigo-300 hover:text-white underline decoration-indigo-500/50">
            自建节点压测标准
          </a>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="text-gray-400">编辑政策:</span>
          <a href="/editorial-policy" class="text-emerald-300 hover:text-white underline decoration-emerald-500/50">
            独立性声明
          </a>
        </div>
        <div class="sm:ml-auto text-gray-400 flex items-center gap-3">
          <span>发布日期: <time class="text-gray-200">{formattedPubDate}</time></span>
          {formattedUpdatedDate && <span>最后更新: <time class="text-emerald-400 font-semibold">{formattedUpdatedDate}</time></span>}
        </div>
      </div>
    </header>

    <!-- Pre-reserved Outline Area (Simplified CSS/JS) -->
    {headings.length > 0 && (
      <aside class="my-6 p-4 rounded-xl bg-dark-card border border-dark-border text-xs">
        <div class="font-bold text-gray-200 mb-2">文章目录导览</div>
        <ul class="space-y-1 text-gray-400">
          {headings.filter(h => h.depth <= 3).map((h) => (
            <li style={`padding-left: ${(h.depth - 1) * 0.75}rem`}>
              <a href={`#${h.slug}`} class="hover:text-brand-glow">
                • {h.text}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <!-- Main Prose Content -->
    <div class="prose-chinese">
      <slot />
    </div>

    <!-- Bottom Post Navigation Buttons -->
    <PostNavButtons prevPost={prevPost} nextPost={nextPost} position="bottom" />

    <!-- Article Bottom FAQ -->
    {faqs && faqs.length > 0 && <FAQ items={faqs} title="本文常见问题解答 (FAQ)" />}

    <!-- Article Bottom CTA -->
    <CTASection
      title="觉得这篇文章有帮助？"
      subtitle="立即查阅我们的全部深度评测与服务对比，开启高效稳定网络体验。"
      buttonText="返回博客列表"
      buttonHref="/blog"
    />
  </article>
</BaseLayout>
