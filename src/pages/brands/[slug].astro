---
import { getCollection } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import BrandNavButtons from '../../components/BrandNavButtons.astro';
import { redirectsMap } from '../../data/redirects';
import { couponData } from '../../data/coupons';
import { sortBrands } from '../../data/brands';

export async function getStaticPaths() {
  const brands = sortBrands(await getCollection('brands'));

  return brands.map((brand, index) => {
    const prevBrand = index > 0 ? { name: brands[index - 1].data.name, slug: brands[index - 1].slug } : null;
    const nextBrand = index < brands.length - 1 ? { name: brands[index + 1].data.name, slug: brands[index + 1].slug } : null;

    return {
      params: { slug: brand.slug },
      props: { brand, prevBrand, nextBrand },
    };
  });
}

import { brandFaqsMap } from '../../data/brandFaqs';
import { getBrandBenchmark } from '../../data/benchmarks';
import { brandDetailsMap } from '../../data/brandDetails';
import { calculateBrandScore } from '../../utils/scoring';

const { brand, prevBrand, nextBrand } = Astro.props;
const benchmark = getBrandBenchmark(brand.slug);
const scoreBreakdown = calculateBrandScore(brand.slug);
const { Content } = await brand.render();
const redirectInfo = redirectsMap[brand.slug];
const targetUrl = redirectInfo?.targetUrl;
const coupon = couponData[brand.slug];
const brandSpec = brandDetailsMap[brand.slug] || {
  price: '¥10.00 / 月 起',
  traffic: '100GB ~ 1000GB / 月',
  multiplier: '1.0x 透明倍率',
  lines: 'BGP 中转 / IEPL 专线',
  protocols: 'VLESS-Reality / Hysteria2 / Shadowsocks',
  devices: 'Windows / macOS / iOS / Android / Linux / tvOS',
  updatedDate: '2026-09-15',
  testDate: '2026-09-15 (基测压测通过)',
};

const breadcrumbItems = [
  { title: '品牌库', href: '/brands' },
  { title: brand.data.name },
];

const brandFaqs = brandFaqsMap[brand.slug] || [
  { q: `${brand.data.name} 适合哪些场景？`, a: `针对 4K 高清播放、AI 交互与日常跨国访问进行了专门优化。` },
  { q: `${brand.data.name} 支持哪些客户端？`, a: `全面支持 Clash Verge Rev、Sing-box 及 Shadowrocket 等主流软件。` },
];
---

<LandingLayout
  title={`${brand.data.name} - 规格参数与深度测评`}
  description={brand.data.description}
  breadcrumbItems={breadcrumbItems}
>
  <div class="space-y-6 py-6">
    <!-- Top Brand Navigation -->
    <BrandNavButtons prevBrand={prevBrand} nextBrand={nextBrand} position="top" />

    <!-- Brand Header Banner -->
    <div class="p-6 sm:p-10 rounded-3xl bg-card-gradient border border-indigo-500/30 space-y-6 relative overflow-hidden shadow-2xl">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="text-xs font-extrabold text-indigo-300 bg-indigo-600/30 border border-indigo-500/40 px-3 py-1 rounded-lg">
            {brand.data.category}
          </span>
          {brand.data.tags.map((t) => (
            <span class="text-xs text-gray-300 bg-gray-800/80 border border-gray-700/50 px-2.5 py-1 rounded-md">#{t}</span>
          ))}
        </div>

        <div class="flex items-center gap-2 text-xs font-mono text-emerald-300 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>最后更新时间：<strong>{brandSpec.updatedDate}</strong></span>
        </div>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          {brand.data.name}
        </h1>

        <p class="text-base text-gray-300 max-w-3xl leading-relaxed">
          {brand.data.description}
        </p>
      </div>

      <!-- Quick CTAs & Coupon Bar -->
      <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-gray-800/80">
        {targetUrl && (
          <a
            href={targetUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white text-sm font-bold px-6 py-3 rounded-xl shadow-lg shadow-indigo-500/20 transition-all transform hover:-translate-y-0.5"
          >
            <span>前往官方网站</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}

        {coupon && (
          <div class="inline-flex flex-wrap items-center gap-2.5 bg-amber-500/10 border border-amber-500/30 rounded-xl px-4 py-2.5 text-xs text-amber-300">
            <span class="font-bold bg-amber-500/20 px-2 py-0.5 rounded text-amber-200">{coupon.label}</span>
            <span class="font-mono font-bold text-white bg-dark-bg/80 border border-amber-500/30 px-2.5 py-1 rounded select-all cursor-pointer" title="点击复制">
              {coupon.code}
            </span>
            <span class="text-[11px] text-amber-400/80 font-mono">（{coupon.source || '官方渠道'} · 最近核验: {coupon.verifiedAt || coupon.updatedAt} · {coupon.expiresAt || '长期有效'}）</span>
          </div>
        )}

        <div class="text-xs text-gray-400 font-mono ml-auto">
          基准压测: {brandSpec.testDate}
        </div>
      </div>
    </div>

    <!-- Brand Technical Spec Grid (核心规格参数明细面板) -->
    <div class="p-6 sm:p-8 rounded-2xl bg-dark-card border border-dark-border space-y-4 shadow-xl">
      <div class="flex items-center justify-between border-b border-gray-800 pb-3">
        <h2 class="text-lg font-extrabold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
          {brand.data.name} 核心规格参数与测试状态
        </h2>
        <span class="text-xs text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 px-3 py-1 rounded-full font-mono">
          最后更新时间：{brandSpec.updatedDate}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">💰 起步价格 (Price)</div>
          <div class="text-sm font-bold text-emerald-400">{brandSpec.price}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">⚡ 每月流量 (Traffic)</div>
          <div class="text-sm font-bold text-white">{brandSpec.traffic}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">📊 节点倍率 (Multiplier)</div>
          <div class="text-sm font-bold text-amber-300">{brandSpec.multiplier}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">🌐 传输线路 (Line Quality)</div>
          <div class="text-sm font-bold text-indigo-300">{brandSpec.lines}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">🔒 支持协议 (Protocols)</div>
          <div class="text-sm font-bold text-purple-300">{brandSpec.protocols}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">💻 全端设备 (Devices)</div>
          <div class="text-sm font-bold text-sky-300">{brandSpec.devices}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">📅 最后更新 (Updated)</div>
          <div class="text-sm font-bold text-gray-200 font-mono">{brandSpec.updatedDate}</div>
        </div>
        <div class="p-3.5 rounded-xl bg-dark-bg/70 border border-gray-800/80 space-y-1">
          <div class="text-xs text-gray-400 font-medium">🧪 压测时间 (Verified)</div>
          <div class="text-sm font-bold text-emerald-300 text-xs font-mono">{brandSpec.testDate}</div>
        </div>
      </div>
    </div>

    <!-- Quantitative Score Engine Breakdown Card (算法自动量化评分面板) -->
    <div class="p-6 sm:p-8 rounded-2xl bg-dark-card border border-dark-border space-y-4 shadow-xl">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-3">
        <div>
          <h2 class="text-lg font-extrabold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
            {brand.data.name} 算法引擎量化评分细则
          </h2>
          <p class="text-xs text-gray-400 mt-1">
            计算逻辑：底层抽样快照数据归一化后按四大维度权重加权生成
          </p>
        </div>
        <div class="flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 px-3 py-1.5 rounded-xl">
          <span class="text-xs text-amber-300 font-medium">综合得星：</span>
          <span class="text-base font-black text-amber-400">⭐ {scoreBreakdown.overallScore} / 10.0</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-1">
        <div class="p-4 rounded-xl bg-dark-bg/80 border border-gray-800 space-y-2">
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>⚡ 线路稳定性 (40%)</span>
            <span class="font-mono text-emerald-400 font-bold">{scoreBreakdown.stabilityScore}</span>
          </div>
          <div class="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
            <div class="h-full bg-emerald-500 rounded-full" style={`width: ${scoreBreakdown.stabilityScore * 10}%`}></div>
          </div>
          <div class="text-[11px] text-gray-500">依据 Ping 延迟、丢包率与下行带宽</div>
        </div>

        <div class="p-4 rounded-xl bg-dark-bg/80 border border-gray-800 space-y-2">
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>🔒 协议全端适配 (20%)</span>
            <span class="font-mono text-purple-400 font-bold">{scoreBreakdown.compatibilityScore}</span>
          </div>
          <div class="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
            <div class="h-full bg-purple-500 rounded-full" style={`width: ${scoreBreakdown.compatibilityScore * 10}%`}></div>
          </div>
          <div class="text-[11px] text-gray-500">依据 VLESS/Sing-box/Clash 导入</div>
        </div>

        <div class="p-4 rounded-xl bg-dark-bg/80 border border-gray-800 space-y-2">
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>🔓 IP纯净与解锁 (20%)</span>
            <span class="font-mono text-amber-400 font-bold">{scoreBreakdown.unlockScore}</span>
          </div>
          <div class="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
            <div class="h-full bg-amber-500 rounded-full" style={`width: ${scoreBreakdown.unlockScore * 10}%`}></div>
          </div>
          <div class="text-[11px] text-gray-500">依据 Netflix/ChatGPT/Claude 成功率</div>
        </div>

        <div class="p-4 rounded-xl bg-dark-bg/80 border border-gray-800 space-y-2">
          <div class="flex items-center justify-between text-xs text-gray-400">
            <span>💰 性价比与透明度 (20%)</span>
            <span class="font-mono text-indigo-400 font-bold">{scoreBreakdown.valueScore}</span>
          </div>
          <div class="w-full h-2 bg-gray-800 rounded-full overflow-hidden">
            <div class="h-full bg-indigo-500 rounded-full" style={`width: ${scoreBreakdown.valueScore * 10}%`}></div>
          </div>
          <div class="text-[11px] text-gray-500">依据单 G 流量价格与倍率真实性</div>
        </div>
      </div>
    </div>

    <!-- Live Benchmark JSON Dataset Table (晚高峰实测数据源明细表) -->
    {benchmark && (
      <div class="p-6 sm:p-8 rounded-2xl bg-dark-card border border-dark-border space-y-4 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-3">
          <div>
            <h2 class="text-lg font-extrabold text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              {brand.data.name} 晚高峰自建节点压测数据集
            </h2>
            <p class="text-xs text-gray-400 mt-1">
              测试环境：{benchmark.isp} | 客户端：{benchmark.clientApp} ({benchmark.mode})
            </p>
          </div>
          <a href="/data-sources" class="text-xs text-brand-glow hover:underline font-mono">
            查看数据来源说明 ➔
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-xs font-mono">
            <thead>
              <tr class="bg-dark-bg/80 border-b border-gray-800 text-gray-300">
                <th class="p-3 font-bold">测试节点</th>
                <th class="p-3 font-bold">传输协议</th>
                <th class="p-3 font-bold">Ping 延迟</th>
                <th class="p-3 font-bold">晚高峰丢包</th>
                <th class="p-3 font-bold">测速下行</th>
                <th class="p-3 font-bold">4K首帧</th>
                <th class="p-3 font-bold">出口 IP 状态</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-800/60">
              {benchmark.records.map((rec) => (
                <tr class="hover:bg-dark-bg/50 transition-colors">
                  <td class="p-3 font-bold text-white">{rec.nodeName}</td>
                  <td class="p-3 text-purple-300">{rec.protocol}</td>
                  <td class="p-3 text-emerald-400 font-bold">{rec.pingMs} ms</td>
                  <td class="p-3 text-amber-300">{rec.packetLossPercent}%</td>
                  <td class="p-3 text-sky-300 font-bold">{rec.downloadMbps} Mbps</td>
                  <td class="p-3 text-gray-300">{rec.firstFrameMs} ms</td>
                  <td class="p-3 text-indigo-300">{rec.ipType}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Content -->
    <div class="prose-custom bg-dark-card p-6 sm:p-10 rounded-2xl border border-dark-border text-gray-300 leading-relaxed space-y-6 shadow-xl">
      <Content />
    </div>

    <!-- Bottom Brand Navigation -->
    <BrandNavButtons prevBrand={prevBrand} nextBrand={nextBrand} position="bottom" />

    <!-- FAQ -->
    <FAQ items={brandFaqs} title={`${brand.data.name} 常见使用解答`} />

    <CTASection
      title="需要比较更多网络服务品牌？"
      subtitle="访问全站对比页，直观了解多款品牌在速度、稳定性与性价比上的客观差异。"
      buttonText="前往服务对比页"
      buttonHref="/compare"
    />
  </div>
</LandingLayout>

<style is:global>
  .prose-custom h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    items-center: center;
    gap: 0.5rem;
  }
  .prose-custom h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #818cf8;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-custom p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: #cbd5e1;
  }
  .prose-custom ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    space-y: 0.5rem;
  }
  .prose-custom li {
    margin-bottom: 0.375rem;
    color: #cbd5e1;
  }
  .prose-custom table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    background: rgba(15, 23, 42, 0.6);
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .prose-custom th {
    background: rgba(99, 102, 241, 0.15);
    color: #e0e7ff;
    font-weight: 700;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .prose-custom td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-size: 0.9rem;
  }
  .prose-custom blockquote {
    border-left: 4px solid #6366f1;
    background: rgba(99, 102, 241, 0.08);
    padding: 1rem 1.25rem;
    border-radius: 0 0.75rem 0.75rem 0;
    margin: 1.5rem 0;
    color: #e2e8f0;
    font-style: italic;
  }
  .prose-custom strong {
    color: #ffffff;
    font-weight: 700;
  }
</style>

