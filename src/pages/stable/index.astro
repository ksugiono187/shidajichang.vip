---

<BaseLayout
  title="稳定机场推荐 - 10 大高稳定性与 IPLC 专线品牌榜单"
  description="精选全网高稳定、低延迟、零断网的优质 IPLC 专线与 BGP 中转机场，涵盖微风网络、飞猫云、唯兔云、星岛梦、U1S1、光速云、全球云、光年梯、极连云与暮光网络。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    <Breadcrumb items={breadcrumbItems} />

    <!-- Page Header -->
    <div class="space-y-4 border-b border-dark-border/80 pb-6">
      <span class="text-xs font-bold text-emerald-400 bg-emerald-600/15 border border-emerald-500/25 px-3 py-1 rounded-md uppercase tracking-wider">
        HIGH STABILITY & DEDICATED LINES
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        稳定机场推荐专区
      </h1>
      <p class="text-sm text-gray-400 max-w-3xl leading-relaxed">
        拒绝掉线与拥堵！本专区仅收录具备 IPLC/IEPL 专线或 BGP 容灾架构、高峰期表现优异的高稳定性网络服务品牌。
      </p>

      <!-- Quick Navigation Buttons -->
      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a
          href="/ranking"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-500/10 border border-indigo-500/30 hover:border-indigo-500/60 hover:bg-indigo-500/20 text-indigo-300 hover:text-white text-xs sm:text-sm font-semibold transition-all shadow-sm"
        >
          <svg class="w-4 h-4 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <span>查看机场排行榜</span>
        </a>

        <a
          href="/cheap"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 hover:border-amber-500/60 hover:bg-amber-500/20 text-amber-300 hover:text-white text-xs sm:text-sm font-semibold transition-all shadow-sm"
        >
          <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>前往便宜机场专区</span>
        </a>
      </div>
    </div>

    <!-- Feature Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">
          99.9%
        </div>
        <h3 class="text-base font-bold text-white">SLA 连通率保障</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          采用全天候监控与多主干备用路由，避免单点故障导致整体断网。
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">
          IPLC
        </div>
        <h3 class="text-base font-bold text-white">内网点对点专线</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          信号不经过公网环境，彻底告别公网大局域网晚高峰严重拥堵丢包现象。
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-dark-card border border-dark-border space-y-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">
          REALITY
        </div>
        <h3 class="text-base font-bold text-white">新一代抗封锁协议</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          全面支持 Trojan / VLESS-Reality / Hysteria 2 协议，隐蔽性好且抗丢包能力强。
        </p>
      </div>
    </div>

    <!-- 10 Stable Brands Ranking Cards Grid -->
    <section class="space-y-8">
      <div class="border-l-4 border-emerald-500 pl-4 py-1">
        <h2 class="text-2xl font-extrabold text-white">
          10 大高稳定性机场推荐与规格卡片
        </h2>
        <p class="text-xs text-gray-400 mt-1">
          结构化展示线路协议、支持支付、节点覆盖、解锁服务、参考套餐与官方查询入口
        </p>
      </div>

      <div class="space-y-8">
        {stableBrands.map((brand) => (
          <RankingCard
            rank={brand.rank}
            name={brand.name}
            slug={brand.slug}
            badge={brand.badge}
            rating={brand.rating}
            slogan={brand.slogan}
            startPrice={brand.startPrice}
            protocols={brand.protocols}
            locations={brand.locations}
            unlocks={brand.unlocks}
            paymentMethods={brand.paymentMethods}
            whyChoose={brand.whyChoose}
            packages={brand.packages}
            queryUrl={brand.queryUrl}
            detailUrl={brand.detailUrl}
          />
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <FAQ items={stableFaqs} title="稳定机场选购疑问解答" />

    <CTASection
      title="需要兼顾性价比？"
      subtitle="访问我们的“便宜机场”推荐专区，查看平价且量大管饱的方案选购建议。"
      buttonText="查看便宜机场推荐"
      buttonHref="/cheap"
    />
  </div>
</BaseLayout>
