---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTASection from '../components/CTASection.astro';

const breadcrumbItems = [{ title: '节点压测与数据测试方法论' }];
---

<BaseLayout
  title="节点压测与数据测试说明 - 十大机场评测"
  description="说明十大机场评测平台的真实测试环境、晚高峰人工抽样压测流程与数据记录方式。"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <Breadcrumb items={breadcrumbItems} />

    <!-- Header -->
    <div class="p-8 sm:p-10 rounded-3xl bg-card-gradient border border-indigo-500/30 space-y-4 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <span class="text-xs font-bold text-indigo-300 bg-indigo-600/30 border border-indigo-500/40 px-3 py-1 rounded-lg uppercase tracking-wider">
        TESTING METHODOLOGY
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        节点测试与数据采集说明
      </h1>
      <p class="text-base text-gray-300 max-w-2xl leading-relaxed">
        实事求是，公开说明我们如何进行节点体验测试与数据整理。
      </p>
    </div>

    <!-- Methodology prose -->
    <div class="prose-custom bg-dark-card p-6 sm:p-10 rounded-2xl border border-dark-border text-gray-300 leading-relaxed space-y-8 shadow-xl">
      <section class="space-y-3">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2 border-b border-gray-800 pb-2">
          <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
          一、测试环境说明
        </h2>
        <p>
          本站的测试数据并非来源于 24 小时全自动天眼监控集群，而是编辑小组成员在实际使用过程中，通过个人家用宽带环境进行的人工抽样记录：
        </p>
        <ul class="list-disc pl-6 space-y-2">
          <li><strong>上海电信环境</strong>：上海电信 1000M FTTH 宽带，用于测试常用节点的 Ping 延迟与首帧响应。</li>
          <li><strong>北京联通环境</strong>：北京联通 500M FTTH 宽带，用于校对北方地区连接质量。</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2 border-b border-gray-800 pb-2">
          <span class="w-3 h-3 rounded-full bg-purple-500"></span>
          二、测试指标的采集方式
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-xl bg-dark-bg border border-gray-800 space-y-1">
            <div class="text-xs font-bold text-indigo-400">1. 晚高峰抽样延迟 (20:00 - 23:00)</div>
            <div class="text-xs text-gray-400">在黄金拥堵时段使用客户端手动测试常用节点的 TCP / ICMP 响应，记录平均延迟范围。</div>
          </div>
          <div class="p-4 rounded-xl bg-dark-bg border border-gray-800 space-y-1">
            <div class="text-xs font-bold text-emerald-400">2. 4K 视频体验</div>
            <div class="text-xs text-gray-400">在 YouTube 播放 4K 视频，记录缓冲区加载时间与流畅度体验。</div>
          </div>
          <div class="p-4 rounded-xl bg-dark-bg border border-gray-800 space-y-1">
            <div class="text-xs font-bold text-amber-400">3. 下行带宽峰值</div>
            <div class="text-xs text-gray-400">使用 Speedtest CLI 在突发测试中测得最高下行峰值速度。</div>
          </div>
          <div class="p-4 rounded-xl bg-dark-bg border border-gray-800 space-y-1">
            <div class="text-xs font-bold text-purple-400">4. 解锁测试</div>
            <div class="text-xs text-gray-400">手动测试 OpenAI (ChatGPT)、Claude 及 Netflix 的访问体验。</div>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2 border-b border-gray-800 pb-2">
          <span class="w-3 h-3 rounded-full bg-amber-500"></span>
          三、评分算法与权重规则 (Score Engine)
        </h2>
        <p>
          本站拒绝凭主观印象随意打分，所有服务商的综合得分由基础抽样数据集结合公开加权算法引擎（Score Engine）归一化计算得出：
        </p>
        <div class="space-y-3 text-xs text-gray-300 font-mono bg-dark-bg p-4 rounded-xl border border-gray-800">
          <div class="flex items-center justify-between border-b border-gray-800 pb-2">
            <span class="text-emerald-400 font-bold">1. 线路稳定性 (Stability, 权重 40%)</span>
            <span>Ping 延迟 (40%) + 丢包率 (30%) + 带宽峰值 (30%)</span>
          </div>
          <div class="flex items-center justify-between border-b border-gray-800 pb-2">
            <span class="text-purple-400 font-bold">2. 协议与全端适配 (Compatibility, 权重 20%)</span>
            <span>VLESS-Reality / Hysteria2 / Sing-box / Clash 支持度</span>
          </div>
          <div class="flex items-center justify-between border-b border-gray-800 pb-2">
            <span class="text-amber-400 font-bold">3. IP 纯净与解锁 (Unlock, 权重 20%)</span>
            <span>Netflix 4K / OpenAI (ChatGPT) / Claude 解锁成功率</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-indigo-400 font-bold">4. 性价比与透明度 (Value, 权重 20%)</span>
            <span>单 G 流量单价 + 流量倍率真实透明度评估</span>
          </div>
        </div>
        <p class="text-xs text-gray-400 font-mono">
          加权计算公式：<code class="text-brand-glow">Overall Score = (Stability × 0.40) + (Compatibility × 0.20) + (Unlock × 0.20) + (Value × 0.20)</code>
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2 border-b border-gray-800 pb-2">
          <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
          四、客观性承诺
        </h2>
        <p>
          因网络波动受本地 ISP、线路出口状况及时间节点影响很大，单次测试数据仅代表特定时间段的样本快照。我们不伪造数据，也不夸大体验，尽量如实呈现。
        </p>
      </section>
    </div>

    <CTASection
      title="了解更多编辑部考量"
      subtitle="阅读我们的独立测评编辑政策与关于本站介绍。"
      buttonText="查看编辑政策"
      buttonHref="/editorial-policy"
    />
  </div>
</BaseLayout>
